PORT=4000

# SerpApi Google Search (optional).
# If omitted, the app runs in demo mode with sample leads.
SERPAPI_API_KEY=

# Discovery controls
DISCOVERY_CONCURRENCY=5
SERPAPI_MAX_REQUESTS=30
CONTACT_TIMEOUT_MS=6000

# SMTP email settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=Recruitment Team
